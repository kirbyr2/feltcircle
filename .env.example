# FeltCircle Node.js server settings. Copy to `.env` (Docker Compose) or
# /etc/feltcircle/feltcircle.env (systemd). Every value is optional.

# Address and port to listen on. Keep 127.0.0.1 behind a reverse proxy.
# (Inside Docker the container always listens on 0.0.0.0:8787; PORT here only
#  changes the host port that docker-compose.yml publishes on 127.0.0.1.)
HOST=127.0.0.1
PORT=8787

# Where the SQLite database lives (created automatically).
DATA_DIR=./data
# DB_FILE=./data/feltcircle.sqlite

# Serve the built web app (apps/web/dist) from this process. Leave unset if a
# separate static host / Nginx serves the frontend.
# STATIC_DIR=./apps/web/dist

# Set to true when running behind Nginx/OpenResty/Caddy so per-IP rate limits
# use X-Forwarded-For. Never enable it when the server is directly exposed.
TRUST_PROXY=false

# Origins allowed to use this backend from a different domain (comma-separated),
# e.g. a frontend on GitHub Pages. "*" allows any origin.
CORS_ORIGINS=*

# Rooms one IP address may create per hour, and the global cap on stored rooms.
ROOM_CREATE_LIMIT=30
MAX_ROOMS=5000
